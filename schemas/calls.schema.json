{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "calls.schema.json",
  "title": "Versioned calls from controlled official sources",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "status", "registryVersion", "closingWindowDays", "counts", "sourceStatus", "items"],
  "properties": {
    "schemaVersion": { "$ref": "common.schema.json#/$defs/schemaVersion" },
    "generatedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
    "status": { "$ref": "common.schema.json#/$defs/datasetStatus" },
    "registryVersion": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
    "closingWindowDays": { "type": "integer", "minimum": 1 },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["totalStored", "active", "open", "closingSoon", "expired", "unverified"],
      "properties": {
        "totalStored": { "type": "integer", "minimum": 0 },
        "active": { "type": "integer", "minimum": 0 },
        "open": { "type": "integer", "minimum": 0 },
        "closingSoon": { "type": "integer", "minimum": 0 },
        "expired": { "type": "integer", "minimum": 0 },
        "unverified": { "type": "integer", "minimum": 0 }
      }
    },
    "sourceStatus": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sourceKey", "sourceName", "officialUrl", "status", "checkedAt", "lastVerifiedAt", "httpStatus",
          "foundCount", "agendaSignalCount", "attempts", "latencyMs", "rateLimitEvents", "message",
          "parserVersion", "sourceVersion", "sourceContentHash"
        ],
        "properties": {
          "sourceKey": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "sourceName": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "officialUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
          "status": { "enum": ["not_checked", "verified", "changed", "forbidden", "parser_error", "unavailable", "stale"] },
          "checkedAt": { "anyOf": [{ "$ref": "common.schema.json#/$defs/timestamp" }, { "type": "null" }] },
          "lastVerifiedAt": { "anyOf": [{ "$ref": "common.schema.json#/$defs/timestamp" }, { "type": "null" }] },
          "httpStatus": { "type": ["integer", "null"], "minimum": 100, "maximum": 599 },
          "foundCount": { "type": "integer", "minimum": 0 },
          "agendaSignalCount": { "type": "integer", "minimum": 0 },
          "attempts": { "type": "integer", "minimum": 0 },
          "latencyMs": { "type": "integer", "minimum": 0 },
          "rateLimitEvents": { "type": "integer", "minimum": 0 },
          "message": { "type": ["string", "null"] },
          "parserVersion": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "sourceVersion": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "sourceContentHash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "sourceRecordId", "title", "venue", "callType", "organizer", "description", "officialUrl",
          "opensAt", "deadlineAt", "deadlineTimezone", "eventDate", "topics", "status", "createdAt",
          "lastCheckedAt", "lastVerifiedAt", "parserVersion", "sourceVersion", "sourceKey", "sourceKeys",
          "sourceName", "contentHash", "versions"
        ],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "sourceRecordId": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "title": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "venue": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "callType": { "enum": ["papers", "special_issue", "special_issue_proposal", "conference", "workshop"] },
          "organizer": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "description": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "officialUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
          "opensAt": { "anyOf": [{ "$ref": "common.schema.json#/$defs/timestamp" }, { "type": "null" }] },
          "deadlineAt": { "anyOf": [{ "$ref": "common.schema.json#/$defs/timestamp" }, { "type": "null" }] },
          "deadlineTimezone": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "eventDate": { "anyOf": [{ "$ref": "common.schema.json#/$defs/date" }, { "type": "null" }] },
          "topics": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "uniqueItems": true },
          "status": { "enum": ["open", "closing-soon", "expired", "unverified"] },
          "createdAt": { "$ref": "common.schema.json#/$defs/timestamp" },
          "lastCheckedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
          "lastVerifiedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
          "parserVersion": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "sourceVersion": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "sourceKey": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "sourceKeys": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "minItems": 1, "uniqueItems": true },
          "sourceName": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
          "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "versions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["version", "contentHash", "observedAt", "title", "description", "officialUrl", "deadlineAt", "eventDate", "topics"],
              "properties": {
                "version": { "type": "integer", "minimum": 1 },
                "contentHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
                "observedAt": { "$ref": "common.schema.json#/$defs/timestamp" },
                "title": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
                "description": { "$ref": "common.schema.json#/$defs/nonEmptyString" },
                "officialUrl": { "type": "string", "format": "uri", "pattern": "^https://" },
                "deadlineAt": { "anyOf": [{ "$ref": "common.schema.json#/$defs/timestamp" }, { "type": "null" }] },
                "eventDate": { "anyOf": [{ "$ref": "common.schema.json#/$defs/date" }, { "type": "null" }] },
                "topics": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/nonEmptyString" }, "uniqueItems": true }
              }
            }
          }
        }
      }
    }
  }
}
